DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Tvinga HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Gamla WordPress-adresser
  RewriteRule ^(blog|feed|comments/feed)/?$ / [L,R=301]
  RewriteRule ^(lonely-beach|old-rock|lost-paradise|last-walk|china-town|adventure-trip|last-shoot|last-day-in-vegas)/?$ / [L,R=301]
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-json) - [F,L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
